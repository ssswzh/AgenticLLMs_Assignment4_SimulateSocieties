# Copy this file to `.env` (same folder) and fill in your keys.
# Run the simulation from the repository root: go run ./simulation_server
# `.env` is gitignored, so your keys will not be committed.

# --- Where things live (relative to the repository root) ---
SIMULATION_DIR=./simulation
# The folder inside SIMULATION_DIR that is loaded AND overwritten by a run.
# Use a fresh copy of base_cafe_spiral for every run (see the Course Guide, step 0.5).
SIMULATION_NAME=ex1_bernard_v1
MAZE_DIR=./maze
SIMULATION_MAZE=the_spiral
# Logs are written to LOG_DIR/SIMULATION_NAME/<timestamp>_<id>/run.jsonl
LOG_DIR=./logs

# --- Text model: any OpenAI-compatible endpoint ---
# Leave TEXT_MODEL_URL empty to use OpenAI itself (Responses API).
# Set it for any other provider or a local server (Chat Completions API).
TEXT_MODEL_URL=http://localhost:11434/v1
TEXT_MODEL_KEY=ollama
# If empty, the server defaults to gpt-5-nano.
TEXT_MODEL_LLM=qwen3.8:27b

# --- Embeddings model: REQUIRED, configured separately from the text model ---
# The text model's URL and key are NOT reused for embeddings. You need an
# OpenAI-compatible embeddings endpoint (OpenAI, or a local server such as Ollama).
# Leave EMBEDDING_URL empty to use OpenAI itself.
EMBEDDING_URL=http://localhost:11434/v1
EMBEDDING_KEY=ollama
# If empty, the server defaults to text-embedding-ada-002.
# Keep the same embedding model for every run you want to compare.
EMBEDDING_MODEL=nomic-embed-text

# --- Optional ---
# LOG_LEVEL=INFO
# LOG_TO_FILE=true

# --- Example: everything local through Ollama (adjust model names to what you pulled) ---
# TEXT_MODEL_URL=http://localhost:11434/v1
# TEXT_MODEL_KEY=ollama
# TEXT_MODEL_LLM=qwen2.5:7b
# EMBEDDING_URL=http://localhost:11434/v1
# EMBEDDING_KEY=ollama
# EMBEDDING_MODEL=nomic-embed-text
